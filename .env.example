# Required in production when issuing or verifying server session cookies (>= 32 chars).
# Generate one with: openssl rand -hex 32
AUTH_SECRET=

# Optional Firebase Web API key & Project ID overrides for server-side token verification
# and password reset / sign-in requests (defaults to values in firebase-applet-config.json).
FIREBASE_API_KEY=
FIREBASE_PROJECT_ID=

# Cloud Firestore is the single source of truth by default and in production.
# Only set ENABLE_LOCAL_STORE=true for offline local development or automated tests
# (permanently ignored whenever NODE_ENV=production).
ENABLE_LOCAL_STORE=false

# Seed the local demo profile/analytics when ENABLE_LOCAL_STORE=true (non-production only).
SEED_DEMO=false

# Directory used by the local dev/test JSON store when ENABLE_LOCAL_STORE=true.
TINKI_DATA_DIR=/tmp/tinki-data

# Optional trusted proxy client IP header for rate limiting (e.g. cf-connecting-ip on
# Cloudflare or x-vercel-forwarded-for on Vercel). Leave unset to use the LAST entry of
# X-Forwarded-For appended by the immediate reverse proxy (never trusts the first entry).
TRUSTED_PROXY_HEADER=